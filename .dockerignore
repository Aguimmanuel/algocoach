# Keep the build context small and stop host artefacts from leaking in.
#
# node_modules matters most: copying a host-built tree into the image can bring
# the wrong platform binaries, and it defeats the npm ci cache layer entirely.
node_modules
dist
.git
.github

# Never bake secrets into an image.
.env
.env.*
!.env.example

# Local database and python cruft
*.db
*.sqlite3
__pycache__
*.py[cod]
.venv
venv
env

# Editor / OS noise
.DS_Store
.vscode
.idea
*.log

# Developer-only test app and artifacts are never part of the Docker build.
tests
backend/test_*.py
test-results
playwright-report

# Explicit nested paths too: never copy backend secrets, DBs or virtualenvs.
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.sqlite
**/*.sqlite3
**/*-wal
**/*-shm
**/__pycache__
**/.venv
**/node_modules
