# Copy this file to  backend/.env  and fill in your key.
#
#   cp backend/.env.example backend/.env
#
# Without a key, the app still runs — it just uses the offline coach, which
# composes a real plan from AlgoCoach's own pattern library.
#
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional. Any Gemini model name works.
#   gemini-2.5-flash  — fast and cheap, the default, great for coaching
#   gemini-2.5-pro    — slower, deeper reasoning, better for hard problems
GEMINI_MODEL=gemini-2.5-flash
