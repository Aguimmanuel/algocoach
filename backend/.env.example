# Copy to backend/.env and fill in what you need.
#   cp backend/.env.example backend/.env
#
# Every value here is optional. With an empty file the app runs entirely
# locally: the offline coach, and a SQLite file for accounts and progress.

# ---------------------------------------------------------------- AI coach
# Empty → offline coach (still useful). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- database
# Empty → local SQLite file at backend/algocoach.db. Nothing to install.
#
# In production, paste the Aiven Service URI exactly as it is shown —
# db.py rewrites the prefix for SQLAlchemy and keeps sslmode=require.
# DATABASE_URL=postgres://user:pass@host:port/defaultdb?sslmode=require
DATABASE_URL=

# -------------------------------------------------------------------- auth
# Signs session tokens. REQUIRED in production: without it a fresh random key
# is generated at every boot, so every deploy signs all users out.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
